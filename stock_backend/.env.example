# 复制为 .env 后按本机环境修改；.env 不入库
APP_ENV=dev
DEBUG=false

# PostgreSQL（默认本机）
DATABASE_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/stock_invest

# Redis（缓存 db0 + Celery 队列 db1/2）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 行情同步
KLINE_INIT_DAYS=730
REALTIME_POLL_INTERVAL=5
SYNC_INCREMENTAL_HOUR=16
SYNC_INCREMENTAL_MINUTE=30

# DeepSeek（阶段三启用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
