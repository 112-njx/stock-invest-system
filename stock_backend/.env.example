# 复制为 .env 后按本机环境修改；.env 不入库
APP_ENV=dev
DEBUG=false

# PostgreSQL（默认本机）
DATABASE_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/stock_invest

# Redis（缓存 db0 + Celery 队列 db1/2）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 行情同步
KLINE_INIT_DAYS=730
REALTIME_POLL_INTERVAL=5
SYNC_INCREMENTAL_HOUR=16
SYNC_INCREMENTAL_MINUTE=30

# JWT（生产必须改为强随机密钥，否则 token 可被伪造）
JWT_SECRET_KEY=dev-secret-change-in-production-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# DeepSeek（阶段三启用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LLM 调用防护（可选，默认值见 app/core/config.py）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1.5
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN=60
LLM_RATE_LIMIT_RPM=30
LLM_TEMPERATURE=0.7

# 本地记忆（默认相对工程根 data/，可覆盖）
MEMORY_DIR=D:/stock-invest-system/stock_backend/data/memory
CHROMA_DIR=D:/stock-invest-system/stock_backend/data/chroma
MEMORY_TOP_K=5
MEMORY_IMPORTANCE_MIN=5
