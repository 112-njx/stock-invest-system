# docker compose 环境变量（复制为 .env.docker 后按需修改；.env.docker 不入库）
POSTGRES_PASSWORD=123456
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-0123456789abcdef
DEEPSEEK_API_KEY=
APP_ENV=prod

# CORS / Cookie 安全（G01）
# CORS_ORIGINS: 逗号分隔可信来源（前端域名），禁止通配 *；域名购买后填写
CORS_ORIGINS=
# COOKIE_SECURE: HTTPS 启用后设 true
COOKIE_SECURE=false
# SSL_REDIRECT: 设 true 后 Nginx 80→443 301 重定向（需先挂载 TLS 证书）
SSL_REDIRECT=false

# 宿主端口按需映射（默认仅绑定 127.0.0.1；对外发布改为 0.0.0.0，HTTP/HTTPS 改 80/443）
NGINX_HTTP_PORT=127.0.0.1:8080
NGINX_HTTPS_PORT=127.0.0.1:8443
PROMETHEUS_PORT=127.0.0.1:9090
GRAFANA_PORT=127.0.0.1:3000

# Grafana 初始管理员
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- 备份与灾难恢复（G05 · P1-1，详见 docs/ops/disaster_recovery.md）----
# BACKUP_DIR: 备份根目录。生产建议指向独立磁盘：设 /backup 并给 api/worker 加 `- /mnt/backup:/backup`
BACKUP_DIR=/app/data/backups
# RCLONE_REMOTE: 对象存储远端（如 oss:stock-invest-backup）；为空=模拟模式，不真同步（生产必须配置）
RCLONE_REMOTE=
# RCLONE_CONFIG: rclone 配置文件路径；留空则用 RCLONE_CONFIG_<REMOTE>_* / AWS_* 环境变量传凭据
RCLONE_CONFIG=
# 保留天数（按需调整）
# BACKUP_PG_RETAIN_DAYS=30      逻辑全量备份（pg_dump）保留天数
# BACKUP_BASE_RETAIN_DAYS=14    物理基础备份（pg_basebackup）保留天数，每周一次 → 留 2 代
# BACKUP_WAL_RETAIN_DAYS=7      WAL 归档保留天数（=PITR 可回溯窗口）
# BACKUP_FILES_RETAIN_DAYS=7    记忆/导出文件镜像保留天数
# BACKUP_ENABLED=true           置 false 后每日备份任务直接跳过
