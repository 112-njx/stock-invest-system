# docker compose 环境变量（复制为 .env.docker 后按需修改；.env.docker 不入库）
POSTGRES_PASSWORD=123456
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-0123456789abcdef
DEEPSEEK_API_KEY=
APP_ENV=prod

# CORS / Cookie 安全（G01）
# CORS_ORIGINS: 逗号分隔可信来源（前端域名），禁止通配 *；域名购买后填写
CORS_ORIGINS=
# COOKIE_SECURE: HTTPS 启用后设 true
COOKIE_SECURE=false
# SSL_REDIRECT: 设 true 后 Nginx 80→443 301 重定向（需先挂载 TLS 证书）
SSL_REDIRECT=false

# 宿主端口按需映射（默认仅绑定 127.0.0.1；对外发布改为 0.0.0.0，HTTP/HTTPS 改 80/443）
NGINX_HTTP_PORT=127.0.0.1:8080
NGINX_HTTPS_PORT=127.0.0.1:8443
PROMETHEUS_PORT=127.0.0.1:9090
GRAFANA_PORT=127.0.0.1:3000

# Grafana 初始管理员
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
